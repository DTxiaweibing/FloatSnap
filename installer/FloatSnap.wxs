<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FloatSnap"
           Manufacturer="FloatSnap"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="2052">

    <SummaryInformation Description="FloatSnap 截图悬浮按钮" Manufacturer="FloatSnap" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 FloatSnap，请先在“应用”里卸载。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FloatSnap" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FloatSnap" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="$(var.MainComponentGuid)">
      <File Id="FloatSnapExe" Source="$(var.SourceExe)" KeyPath="yes">
        <!-- 非通告式快捷方式（Advertise=no）且不指定 Icon：
             图标直接取目标 exe 内嵌的图标，避免通告式快捷方式图标为空/白纸 -->
        <Shortcut Id="StartMenuShortcut"
                  Directory="AppMenuFolder"
                  Name="FloatSnap"
                  Description="点一下截全屏"
                  Advertise="no" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="FloatSnap"
                  Description="点一下截全屏"
                  Advertise="no" />
      </File>
    </Component>

    <Component Id="AutoStart" Directory="INSTALLFOLDER" Guid="$(var.AutoStartComponentGuid)">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="FloatSnap"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]FloatSnap.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="FloatSnap" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AutoStart" />
    </Feature>

  </Package>
</Wix>
